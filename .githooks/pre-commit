#!/usr/bin/env bash
# Kitbag pre-commit gate. Enable with: bash scripts/install-hooks.sh
# Lints staged files only; rejects the commit on any violation. Bypass in a
# genuine emergency with `git commit --no-verify` (and fix it in the next commit).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

# Blocking: the lint gate.
bash "$root/scripts/lint.sh" --staged

# Optional local override: run a personal, untracked hook if this clone has one
# (e.g. an author-identity guard). No-op for anyone without it — keeps personal
# rules out of the shared repo while surviving `install-hooks.sh` (SPEC-neutral).
local_hook="$(git rev-parse --git-common-dir)/hooks-local/pre-commit"
[ -x "$local_hook" ] && exec "$local_hook" "$@"
