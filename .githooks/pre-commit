#!/usr/bin/env bash
# Kitbag pre-commit gate. Enable with: bash scripts/install-hooks.sh
# Lints staged files only; rejects the commit on any violation. Bypass in a
# genuine emergency with `git commit --no-verify` (and fix it in the next commit).
set -euo pipefail
exec bash "$(git rev-parse --show-toplevel)/scripts/lint.sh" --staged
