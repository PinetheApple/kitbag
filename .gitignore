# Native
build/
native/audio_core/build/
# CMake per-module intermediates (core-native's android module has no
# prebuild-written .gitignore; app-shell's android/.gitignore covers its own).
.cxx/

# Node / React Native — the app lands per SPEC.md §13
node_modules/
.turbo/
.expo/
*.tsbuildinfo

# Expo generated (regenerated by prebuild/start; not source of truth).
# NOTE: the generated android/ tree is COMMITTED (SPEC §13.8.1) — do not
# ignore it here. Its build artifacts are excluded by the android/.gitignore
# that prebuild writes. iOS is out of scope (Linux dev, Android-only gate) and
# follows the Expo-generated default — ignored, regenerated by prebuild.
packages/app-shell/ios/
**/expo-env.d.ts
dist/
web-build/
.metro-health-check*

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Python
__pycache__/

.claude/worktrees/

# project-loop runtime artifacts
stream-*.jsonl
loop.log
.loop-halt

# Signing material (#48). The release keystore lives outside the repo; if one of
# these ever lands in a commit the published key is compromised permanently.
*.p12
*.jks
*.key
.env
