<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/kitbag_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <TextView
        android:id="@+id/kitbag_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <ImageView
        android:id="@+id/kitbag_action_0"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:tint="@color/kitbag_notification_action"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/kitbag_action_1"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:tint="@color/kitbag_notification_action"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/kitbag_action_2"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:tint="@color/kitbag_notification_action"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/kitbag_action_3"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:tint="@color/kitbag_notification_action"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/kitbag_action_4"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:tint="@color/kitbag_notification_action"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/kitbag_action_5"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:tint="@color/kitbag_notification_action"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
