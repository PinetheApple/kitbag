{
  "name": "@kitbag/core-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "node scripts/generate-constants.ts",
    "generate:check": "node scripts/generate-constants.ts --check"
  },
  "dependencies": {
    "@kitbag/core-plugin-api": "workspace:*"
