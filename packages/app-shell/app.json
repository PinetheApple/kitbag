{
  "expo": {
    "name": "Kitbag",
    "slug": "kitbag",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "kitbag",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.kitbag.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon/foreground.png",
        "backgroundImage": "./assets/adaptive-icon/background.png",
        "monochromeImage": "./assets/adaptive-icon/monochrome.png",
        "backgroundColor": "#0E0D10"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      ["expo-router", { "sitemap": false }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F5F3EE",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0E0D10"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.kitbag.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kitbag uses the microphone to hear your instrument while the tuner screen is open. It stops listening when you leave the tuner or switch apps."
      }
    }
  }
}
