{
  "expo": {
    "name": "Kitbag",
    "slug": "kitbag",
    "version": "0.0.1",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0E0D10",
      "resizeMode": "contain"
    },
    "orientation": "portrait",
    "scheme": "kitbag",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.kitbag.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon/foreground.png",
        "backgroundImage": "./assets/adaptive-icon/background.png",
        "monochromeImage": "./assets/adaptive-icon/monochrome.png",
        "backgroundColor": "#0E0D10"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.kitbag.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kitbag uses the microphone to hear your instrument while the tuner screen is open. It stops listening when you leave the tuner or switch apps."
      }
    }
  }
}
