{
  "name": "@kitbag/app-shell",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typegen": "expo customize tsconfig.json",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "test": "vitest run --config eval/vitest.config.mjs && vitest run --config vitest.ui.config.mjs",
    "generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/toolBuild/writeRules.ts",
    "generate:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/toolBuild/writeRules.ts --check"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@kitbag/core-db": "workspace:*",
    "@kitbag/core-design": "workspace:*",
    "@kitbag/core-native": "workspace:*",
    "@kitbag/core-plugin-api": "workspace:*",
    "@kitbag/core-state": "workspace:*",
    "@kitbag/tool-library": "workspace:*",
    "@kitbag/tool-metronome": "workspace:*",
    "@kitbag/tool-stems": "workspace:*",
    "@kitbag/tool-sync": "workspace:*",
    "@kitbag/tool-tuner": "workspace:*",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "nativewind": "5.0.0-rc.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react-test-renderer": "~19.3.1",
    "eslint": "9.39.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-kitbag": "workspace:*",
    "postcss": "^8.5.33",
    "react-test-renderer": "19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  }
}
