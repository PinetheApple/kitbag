# Release signing (#48). Copy to .env and fill in; .env is gitignored.
# Gradle reads these through System.getenv, so they must be exported into the
# build's environment. With all three unset, release builds are debug-signed and
# say so in the build log.
#
# Create a keystore (PKCS12, one password for store and key):
#   keytool -genkeypair -v -storetype pkcs12 -keystore <path>.p12 \
#     -alias <alias> -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the file outside the repo and back it up. The first key an app is
# published under cannot be changed later.

# Absolute path to the .p12 keystore.
ANDROID_KEYSTORE_PATH=

# Password for the keystore (PKCS12: same value protects the key).
ANDROID_KEYSTORE_PASSWORD=

# Alias of the key inside the keystore.
ANDROID_KEY_ALIAS=
